    // ---- NO APAGUES LA LUZ: ajustes propios (canvas 16:9, loader, fullscreen) ----
    window.napal_fit_canvas = function () {
        const c = document.querySelector('canvas.emscripten');
        if (c && c.width >= 2 && c.height >= 2) {
            c.style.position = 'fixed';
            c.style.left = '50%'; c.style.top = '50%';
            c.style.right = 'auto'; c.style.bottom = 'auto';
            c.style.transform = 'translate(-50%, -50%)';
            c.style.margin = '0';
            if (window.napal_fill) {
                // LLENAR: estirar el canvas hasta cubrir toda la ventana
                c.style.width = window.innerWidth + 'px';
                c.style.height = window.innerHeight + 'px';
            } else {
                const ar = c.width / c.height;
                let w = window.innerWidth, h = window.innerHeight;
                if (w / h > ar) { w = Math.round(h * ar); } else { h = Math.round(w / ar); }
                c.style.width = w + 'px';
                c.style.height = h + 'px';
            }
        }
        const ib = document.getElementById('infobox');
        if (ib && ib.style.display !== 'none') {
            ib.style.left = Math.round((window.innerWidth - ib.offsetWidth) / 2) + 'px';
            ib.style.top = Math.round((window.innerHeight - ib.offsetHeight) / 2) + 'px';
        }
    };
    window.napal_fill = false;
    window.napal_set_fill = function (v) {
        window.napal_fill = !!v;
        window.napal_fit_canvas();
    };
    window.napal_fullscreen = function () {
        if (!document.fullscreenElement) {
            if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    };
    window.napal_loader_text = function (s) {
        const st = document.getElementById('status');
        if (st) st.textContent = s;
        const ib = document.getElementById('infobox');
        if (ib) ib.textContent = s;
    };
    window.napal_loader_hide = function () {
        const t = document.getElementById('transfer');
        if (t) t.hidden = true;
        const ib = document.getElementById('infobox');
        if (ib) ib.style.display = 'none';
    };
    window.addEventListener('resize', function () { window.napal_fit_canvas(); });
    document.addEventListener('fullscreenchange', function () { window.napal_fit_canvas(); });
    setInterval(function () { window.napal_fit_canvas(); }, 700);
    // aviso de girar el movil en vertical (solo tactil)
    window.napal_orientation = function () {
        const d = document.getElementById('napal_rotate');
        if (!d) return;
        const touch = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
        const portrait = window.innerHeight > window.innerWidth;
        const started = !!document.fullscreenElement || (document.querySelector('canvas.emscripten') || {}).width > 2;
        d.style.display = (touch && portrait && started) ? 'flex' : 'none';
    };
    window.napal_rotate_tap = function () {
        // tocar el aviso = ponerse a pantalla completa directamente
        if (!document.fullscreenElement) {
            window.napal_fullscreen();
        } else if (document.exitFullscreen) {
            document.exitFullscreen();
        }
    };
    window.addEventListener('resize', function () { window.napal_orientation(); });
    window.addEventListener('orientationchange', function () { window.napal_orientation(); });
    setInterval(function () { window.napal_orientation(); }, 800);

    // PWA: registrar el service worker (cache offline). Solo en contexto seguro
    // (https o localhost); en la LAN por http no hay SW y se juega igual.
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('sw.js').catch(function () {});
        });
    }

    </script>

